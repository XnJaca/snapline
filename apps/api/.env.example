NODE_ENV=development
PORT=3000

# Runtime — rol restringido, RLS APLICA (ADR-0006)
DB_HOST=localhost
DB_PORT=5544
DB_NAME=snapline
DB_USERNAME=snapline_app
DB_PASSWORD=snapline_dev

# Migraciones y seeds — owner, bypassa RLS. Nunca usar en runtime.
DB_MIGRATION_USERNAME=snapline_migrator
DB_MIGRATION_PASSWORD=snapline_dev

# Zona horaria por defecto de una empresa nueva
DEFAULT_TIMEZONE=America/New_York

# Generar uno propio por entorno:  openssl rand -base64 48
# El de produccion NUNCA se comparte con desarrollo.
JWT_SECRET=

# Backblaze B2 — API compatible con S3 (ADR-0010).
# El bucket NO es público: todo se sirve con URL firmada.
#
# Para desarrollo alcanza con cualquier valor no vacío: la firma se calcula local
# (HMAC) y no consulta a Backblaze. Solo la subida y la descarga reales necesitan
# llaves válidas del bucket.
#
# El nombre del bucket va con guiones, NUNCA con guion bajo: se usa como subdominio
# y un guion bajo no es válido en DNS. Pasos completos en docs/PENDIENTES.md.
# La región NO se adivina: se copia del endpoint que muestra el bucket en la
# consola de B2. Con la región equivocada Backblaze responde InvalidAccessKeyId,
# que suena a llave mala y en realidad es región mala.
STORAGE_ENDPOINT=https://s3.<region>.backblazeb2.com
STORAGE_REGION=<region>
STORAGE_BUCKET=snapline-dev
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_FORCE_PATH_STYLE=false
