meta {
  name: Login trabajador (por teléfono)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "identifier": "{{worker_identifier}}",
    "password": "{{worker_password}}"
  }
}

script:post-response {
  if (res.body.accessToken) bru.setVar("worker_token", res.body.accessToken);
}

assert {
  res.status: eq 200
  res.body.membership.role: eq WORKER
  res.body.user.locale: eq es
}
