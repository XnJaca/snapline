meta { name: PUBLIC sin photo release
  type: http
  seq: 4
}
post { url: {{base_url}}/media/{{asset_id_sin_release}}/visibility
  body: json
  auth: none
}
body:json {
  { "visibility": "PUBLIC" }
}
docs {
  Publicar la casa de alguien sin su permiso. La API lo rechaza, y si la API
  fallara lo rechaza el trigger de la base — la regla vive en los dos lados a
  propósito.
}
assert { res.status: eq 400 }
