meta { name: GPS falseado — el servidor recalcula
  type: http
  seq: 1
}
post { url: {{base_url}}/time-entries/clock-in
  body: json
  auth: none
}
body:json {
  {
    "projectId": "{{project_id}}",
    "deviceRecordedAt": "{{$isoTimestamp}}",
    "lat": 39.65,
    "lng": -76.61,
    "clockInWithinGeofence": true,
    "clockInDistanceM": 0,
    "isMockLocation": true
  }
}
docs {
  El dispositivo miente en tres campos: dice estar dentro de la geocerca, dice
  distancia 0, y viene con GPS simulado.

  El servidor ignora withinGeofence y distanceM del request (whitelist del
  ValidationPipe), recalcula desde lat/lng contra el sitio (~40 km) y levanta
  OUTSIDE_GEOFENCE + MOCK_LOCATION.

  Si esta prueba empieza a devolver clockInWithinGeofence=true, el control de
  asistencia es decorativo.
}
assert { res.status: eq 201
  res.body.clockInWithinGeofence: eq false
  res.body.isMockLocation: eq true
}
