meta { name: Cambiar el precio no reescribe documentos emitidos
  type: http
  seq: 9
}
patch { url: {{base_url}}/service-items/{{service_item_id}}
  body: json
  auth: none
}
body:json {
  { "unitPriceCents": 540 }
}
docs {
  Sube el precio 20% después de emitir el estimado. Verificar a mano que
  GET /estimates/{{estimate_id}} sigue mostrando el precio viejo.

  Si el total del estimado cambia, se rompió la regla 14: las líneas copian,
  no referencian.
}
assert { res.status: eq 200
  res.body.unitPriceCents: eq 540
}
