meta { name: Corrección de dirección reintentada con la misma clave
  type: http
  seq: 14
}
post { url: {{base_url}}/sync
  body: json
  auth: none
}
body:json {
  {
    "operations": [
      {
        "clientId": "{{site_update_client_id}}",
        "type": "site.update",
        "targetId": "{{site_id}}",
        "payload": {
          "address": {
            "line1": "9800 Georgia Ave",
            "city": "Silver Spring",
            "state": "MD",
            "postalCode": "20902",
            "country": "US"
          }
        },
        "occurredAt": "2026-08-09T14:00:00.000Z"
      }
    ]
  }
}
docs {
  La red se cortó después de que el servidor aplicara la corrección, así que el
  móvil reintenta con la misma clave. Vuelve `duplicate`, que es éxito: la
  operación sale de la bandeja igual que si fuera nueva.

  Este es el caso que la idempotencia por "el recurso ya existe" no atajaba: en
  un `update` el recurso siempre existe. Corre después de
  `owner/sync-push-site-update`, que es el que guarda la clave.
}
assert { res.status: eq 201
  res.body.failed: eq 0
  res.body.results[0].status: eq duplicate
}
