meta { name: Clientes — otorgar photo release
  type: http
  seq: 4
}
post { url: {{base_url}}/customers/{{customer_id}}/photo-release
  body: json
  auth: none
}
body:json {
  { "granted": true }
}
docs {
  Es lo único que habilita publicar contenido de sus proyectos. Un trigger de la
  base rechaza visibility=PUBLIC sin esto, aunque la API falle.
}
assert { res.status: eq 200
  res.body.photoReleaseGrantedAt: isString
}
