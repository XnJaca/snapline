meta { name: Factura — desde el estimado
  type: http
  seq: 23
}
post { url: {{base_url}}/estimates/{{estimate_id}}/invoice
  body: json
  auth: none
}
body:json {
  { "dueAt": "2026-09-08T00:00:00Z" }
}
script:post-response {
  if (res.body.id) bru.setVar("invoice_id", res.body.id);
}
docs {
  Copia las líneas ya congeladas del estimado. No vuelve a leer el catálogo, así
  que un cambio de precio entre aceptar y facturar no altera el monto.
}
assert { res.status: eq 201
  res.body.balanceCents: isNumber
}
