meta { name: Proyectos — crear
  type: http
  seq: 6
}
post { url: {{base_url}}/projects
  body: json
  auth: none
}
body:json {
  {
    "customerId": "{{customer_id}}",
    "siteId": "{{site_id}}",
    "name": "Canoas Johnson",
    "serviceType": "gutters",
    "status": "SCHEDULED"
  }
}
script:post-response {
  if (res.body.id) bru.setVar("project_id", res.body.id);
}
assert { res.status: eq 201
  res.body.clientVisibilityMode: eq STAGES
}
