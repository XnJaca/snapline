meta { name: Media — subir a PUBLIC
  type: http
  seq: 11
}
post { url: {{base_url}}/media/{{asset_id}}/visibility
  body: json
  auth: none
}
body:json {
  { "visibility": "PUBLIC" }
}
docs {
  Escalera INTERNAL → CLIENT → PUBLIC. Exige EXIF limpio, y si falta lo limpia
  sola: publicar con GPS expone la dirección de la vivienda.
}
assert { res.status: eq 200
  res.body.visibility: eq PUBLIC
}
