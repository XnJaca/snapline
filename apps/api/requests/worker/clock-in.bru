meta { name: Marcar entrada
  type: http
  seq: 1
}
post { url: {{base_url}}/time-entries/clock-in
  body: json
  auth: none
}
body:json {
  {
    "projectId": "{{project_id}}",
    "deviceRecordedAt": "{{$isoTimestamp}}",
    "lat": 39.2904,
    "lng": -76.6122,
    "accuracyM": 8,
    "deviceId": "pixel-8-abc",
    "isMockLocation": false,
    "recordedOffline": false
  }
}
script:post-response {
  if (res.body.id) bru.setVar("time_entry_id", res.body.id);
}
docs {
  El dispositivo manda lat/lng crudas. NO manda distancia ni withinGeofence:
  eso lo calcula el servidor contra las coordenadas del sitio.

  Marcar nunca falla: sin GPS ni foto se registra igual, con bandera.
}
assert { res.status: eq 201
  res.body.clockInWithinGeofence: eq true
  res.body.status: eq PENDING
  res.body.serverReceivedAt: isString
}
