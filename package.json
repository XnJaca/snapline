{
  "name": "snapline",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "api:dev": "pnpm --filter @snapline/api dev",
    "api:db:up": "pnpm --filter @snapline/api db:up",
    "api:migrate": "pnpm --filter @snapline/api migration:run",
    "api:seed": "pnpm --filter @snapline/api seed",
    "contracts:generate": "pnpm --filter @snapline/api openapi:generate && pnpm --filter @snapline/contracts generate",
    "tokens:generate": "pnpm --filter @snapline/tokens generate"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.2"
  }
}
